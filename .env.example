# Backend Configuration
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/instructor_db
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=generate-a-random-secret-for-telegram-webhook
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# AI Provider (Groq or NVIDIA)
AI_PROVIDER=groq
GROQ_API_KEY=
NVIDIA_API_KEY=

# Frontend URLs (for CORS)
FRONTEND_MINI_APP_URL=http://localhost:5173
FRONTEND_ADMIN_URL=http://localhost:5174

# Application Settings
TIMEZONE=Asia/Almaty
ENABLE_DEBUG=false

GROQ_MODEL=llama-3.3-70b-versatile
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
